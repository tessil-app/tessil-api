# ─── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/jtransfer

# Test database — required when running `bun test`. MUST be a disposable
# database; the test harness truncates all tables between tests.
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/jtransfer_test

# ─── Server ────────────────────────────────────────────────────────────────
PORT=3000
CORS_ORIGINS=http://localhost:5173

# Public frontend origin. Used to compose magic-link URLs and as the
# default base for WebAuthn RP origin and the Polar checkout success URL.
# MUST be set explicitly in production (the production guard refuses to
# boot if this still points at localhost).
APP_URL=http://localhost:5173

# NODE_ENV=production           # gates the production safety checks at the end of env.ts

# ─── Cloudflare R2 storage ─────────────────────────────────────────────────
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=jtransfer

# ─── Free-tier upload limits (Pro overrides live in src/config/tiers.ts) ──
# These are the Free-tier defaults. Pro caps are constants in tiers.ts;
# Anonymous caps are tighter constants. See ADR-0006 for the full table.
# MAX_FILE_SIZE=1073741824          # 1 GiB
# MAX_TOTAL_UPLOAD_SIZE=1073741824  # 1 GiB total per transfer

# ─── Redis (optional — falls back to in-memory) ────────────────────────────
# Required in production for rate limits + session-anomaly dedup to
# survive restarts. In dev the in-memory fallback is fine.
# REDIS_URL=redis://localhost:6379

# ─── Rate limits (all optional, shown with defaults) ───────────────────────
# RATE_LIMIT_VALIDATE_PER_MINUTE=30
# RATE_LIMIT_UPLOADS_PER_MINUTE=20
# RATE_LIMIT_DOWNLOADS_PER_MINUTE=20
# RATE_LIMIT_DAILY_TRANSFERS=20            # Free-tier daily transfer count
# RATE_LIMIT_DAILY_DOWNLOADS=200
# RATE_LIMIT_MONTHLY_UPLOAD_GB=2           # Free-tier monthly upload volume (GB)

# Magic-link auth rate limits (audit doc 18 §2)
# RATE_LIMIT_AUTH_REQUEST_PER_HOUR_PER_EMAIL=5
# RATE_LIMIT_AUTH_REQUEST_PER_HOUR_PER_IP=20
# RATE_LIMIT_AUTH_VERIFY_PER_MINUTE_PER_IP=10

# ─── Email — Scaleway Transactional Email (transactional only per ToS) ────
# Required in production. When PROJECT_ID + SECRET_KEY are unset (dev),
# the email service logs the magic link / notification to stdout instead.
# SCW_TEM_REGION=fr-par
# SCW_TEM_PROJECT_ID=your_scw_tem_project_id
# SCW_TEM_SECRET_KEY=your_scw_tem_secret_key
# EMAIL_FROM=noreply@your-domain.tld
# EMAIL_FROM_NAME=JTransfer
# EMAIL_REPLY_TO=support@your-domain.tld

# ─── Download token secret ────────────────────────────────────────────────
# HMAC secret for the short-lived "password OK" download token issued by
# /api/download/transfer/:id/verify. In production MUST be set explicitly
# so tokens survive restarts. In dev a per-process random value is used.
# Generate with: openssl rand -base64 32
# DOWNLOAD_TOKEN_SECRET=

# ─── WebAuthn / passkeys (audit doc 27, D-108) ────────────────────────────
# Both default off APP_URL — set explicitly only if your RP ID/origin
# differs from the deployment domain.
# WEBAUTHN_RP_ID=jtransfer.com         # host without scheme/port
# WEBAUTHN_RP_ORIGIN=https://jtransfer.com
# WEBAUTHN_RP_NAME=JTransfer

# ─── IP minimization / GeoIP (audit doc 19, ADR-0002) ─────────────────────
# MaxMind credentials are only used by infra/setup-geoip.sh to download
# the GeoLite2 Country / ASN / City MMDB files. Register a free account
# at https://www.maxmind.com/en/geolite2/signup to get them.
# MAXMIND_ACCOUNT_ID=your_maxmind_account_id
# MAXMIND_LICENSE_KEY=your_maxmind_license_key
# GEOIP_DIR=/var/lib/geoip                  # where the MMDB files live on disk
# ENABLE_IP_DERIVATION=true                 # set to false to disable geo/ASN derivation entirely (debugging only)
# ENABLE_SESSION_ANOMALY_DETECTION=true     # set to false to silence the same-session ip_hmac comparison
# ENABLE_SESSION_ANOMALY_EMAIL=false        # set to true to email users on detected session anomalies (ADR-0003)

# ─── Polar — payment processor + Merchant of Record (ADR-0007) ────────────
# Required for Pro subscriptions to work end-to-end. In dev keep the
# defaults; the SDK only initialises lazily on the first checkout/portal
# /webhook call, so unset values don't break the rest of the API.
#
# Setup checklist:
#   1. Create a Polar account → create a "Pro" product
#   2. Add monthly (€5) and annual (€50) prices → paste IDs below
#   3. Generate webhook secret in Polar dashboard → set POLAR_WEBHOOK_SECRET
#   4. Configure webhook URL in Polar: https://<your-api>/api/billing/webhook
#   5. Subscribe to subscription.* events in Polar's webhook config
#   6. Generate access token in Polar dashboard → set POLAR_ACCESS_TOKEN
#   7. Accept Polar's standard DPA in merchant settings
# POLAR_SERVER=sandbox                       # 'sandbox' or 'production'
# POLAR_ACCESS_TOKEN=polar_oat_...
# POLAR_WEBHOOK_SECRET=whsec_...
# POLAR_PRODUCT_ID_MONTHLY=prod_...
# POLAR_PRODUCT_ID_ANNUAL=prod_...
# POLAR_PRODUCT_ID_PASS=prod_...             # one-time product (€1) for a single-transfer pass
# POLAR_SUCCESS_URL=                         # defaults to ${APP_URL}/thanks

# ─── Pay-to-send experiment ───────────────────────────────────────────────
# When true, creating a transfer needs an active subscription or a paid
# single-transfer pass. Downloads stay free. Off restores the free tiers.
# In production the API refuses to boot with this on unless
# POLAR_ACCESS_TOKEN, POLAR_WEBHOOK_SECRET, POLAR_PRODUCT_ID_MONTHLY and
# POLAR_PRODUCT_ID_PASS are all set.
# PAYWALL_ENABLED=false
